# Tipo v0.2.0-beta.6 — configuración local
PUERTO=8082

# --- Modelo ---
# gemma4:e4b es el modelo local recomendado por defecto para esta beta.
# Puede cambiarse desde la interfaz por cualquier modelo ya descargado en Ollama.
MODELO_BASE=gemma4:e4b
MODELO_NOMBRE=gemma4:e4b
# Crear modelo derivado desde Modelfile. En beta queda desactivado por defecto.
TIPO_CREAR_MODELO_DERIVADO=false

# --- Imagen base Python ---
# El instalador Windows resuelve automáticamente python:3.12-slim a digest
# y escribe la referencia fijada en .env antes de construir la imagen.
# No requiere ninguna acción manual del usuario final.
PYTHON_IMAGE=python:3.12-slim
OLLAMA_IMAGE=ollama/ollama@sha256:7db82c93ff9fae4011a2aa10931b1d2c2a228d508b8736366e3fbaee616b2e8c
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=8192

# --- Segmentación por zonas ---
# Tipo admite subir el libro completo. En lugar de procesar todo el volumen,
# localiza las zonas donde se concentran los datos descriptivos y descarta el
# cuerpo. Estas variables ajustan esa segmentación.
# Páginas iniciales tratadas como preliminares (cubierta, portada, verso):
ZONA_PAGINAS_PRELIMINARES=12
# Páginas finales tratadas como finales (colofón, depósito legal):
ZONA_PAGINAS_FINALES=6
# Tope de páginas que se rasterizan para la ruta visión (preliminares + finales):
ZONA_PAGINAS_VISION_MAX=14
# Para DOCX/TXT, que no tienen paginación real, recorte por caracteres:
ZONA_CHARS_INICIO=8000
ZONA_CHARS_FINAL=3000

# --- Calidad de OCR ---
# Por debajo de este umbral (0.0-1.0), el texto extraído de las zonas se
# considera insuficiente y se usa la ruta visión sobre esas mismas zonas.
UMBRAL_CALIDAD_OCR=0.5

# --- Ejemplos few-shot ---
# Fichero de ejemplos resueltos que se inyectan en el prompt. Si no existe,
# Tipo funciona igual sin few-shot. Se genera con examples/construir_ejemplos_bne.py.
RUTA_EJEMPLOS=/app/schemas/ejemplos-monografia.yaml
MAX_EJEMPLOS_PROMPT=3

# --- Límites de procesamiento ---
# Con segmentación por zonas el coste ya no depende del total de páginas, así
# que el tope puede ser alto.
PAGINAS_MAXIMAS_PDF=1200
MAX_ARCHIVOS_CONJUNTO=12

# --- Sandbox de parsers ---
USAR_SANDBOX_PARSERS=true
SANDBOX_TIMEOUT_SEGUNDOS=90
SANDBOX_MEMORIA_MB=1536

# --- Red y seguridad ---
ALLOW_REMOTE_OLLAMA=false
ALLOW_NETWORK_EXPOSURE=false
INCLUIR_HASH_DOCUMENTO_AUDITORIA=true
PERMITIR_APAGADO_UI=true


# --- Autenticación local ---
# Activada por defecto. En el primer arranque se crea el usuario administrador
# desde la pantalla de configuración. No se guarda contraseña en claro.
TIPO_AUTH_DISABLED=false
TIPO_DATA_DIR=/app/data
TIPO_SESSION_TTL_SECONDS=43200
TIPO_PASSWORD_MIN_LENGTH=10
TIPO_COOKIE_SECURE=false
